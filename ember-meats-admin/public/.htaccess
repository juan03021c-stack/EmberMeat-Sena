# Las rutas de React (/catalogo, /productos...) no son archivos reales:
# Apache debe responder con index.html para que React muestre la página.
# La carpeta backend/ y los archivos que existen se sirven normal.
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/backend/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
